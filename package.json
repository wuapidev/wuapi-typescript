{
  "name": "@wuapidev/sdk",
  "version": "0.3.0",
  "description": "TypeScript SDK for wuapi, a WhatsApp API for developers. Link numbers by QR or pairing code, send and receive messages, manage chats, contacts, groups and channels, split them into projects and verify webhooks.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-api",
    "messaging",
    "webhooks",
    "sdk"
  ],
  "homepage": "https://wuapi.dev/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuapidev/wuapi-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/wuapidev/wuapi-typescript/issues"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
